{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tkdrama",
  "version": "1.1.0",
  "mainBinaryName": "tkdrama-app",
  "identifier": "com.tkdrama.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "tkdrama",
        "width": 1100,
        "height": 740,
        "minWidth": 780,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/ffmpeg"],
    "resources": {
      "binaries/FFMPEG-LICENSE.txt": "FFMPEG-LICENSE.txt",
      "binaries/avcodec-63.dll": "avcodec-63.dll",
      "binaries/avdevice-63.dll": "avdevice-63.dll",
      "binaries/avfilter-12.dll": "avfilter-12.dll",
      "binaries/avformat-63.dll": "avformat-63.dll",
      "binaries/avutil-61.dll": "avutil-61.dll",
      "binaries/swresample-7.dll": "swresample-7.dll",
      "binaries/swscale-10.dll": "swscale-10.dll"
    },
    "publisher": "Alan Araujo",
    "copyright": "",
    "category": "Utility",
    "shortDescription": "Baixa novelas verticais do TikTok",
    "longDescription": "Descobre todos os episodios de uma novela vertical do TikTok e baixa em fila, com retomada, prioridade e escolha de qualidade.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
